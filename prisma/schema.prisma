generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  role        String   @default("user") // admin | moderator | user
  fullName    String
  email       String   @unique
  phone       String   @default("")
  address     String   @default("")
  department  String   @default("")
  isFirstLogin Boolean @default(true)
  createdAt   String
  createdBy   String   @default("system")

  // Relations
  assignedTasks    Task[]           @relation("AssignedTo")
  createdTasks     Task[]           @relation("AssignedBy")
  accountRequests  AccountRequest[] @relation("RequestedBy")
  resolvedRequests AccountRequest[] @relation("ResolvedBy")
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  assignedToId String
  assignedById String
  status      String   @default("pending")   // pending | in-progress | review | done
  priority    String   @default("medium")    // low | medium | high | critical
  dueDate     String
  createdAt   String
  updatedAt   String
  notes       String   @default("[]")        // JSON array stored as string

  assignedTo  User @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedBy  User @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)
}

model AccountRequest {
  id            String  @id @default(cuid())
  requestedById String
  requestedRole String  @default("user")
  fullName      String
  email         String
  department    String  @default("")
  reason        String
  status        String  @default("pending") // pending | approved | rejected
  createdAt     String
  resolvedAt    String?
  resolvedById  String?

  requestedBy   User  @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  resolvedBy    User? @relation("ResolvedBy",  fields: [resolvedById],  references: [id])
}
